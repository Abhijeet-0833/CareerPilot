# AI Career OS Environment Variables Template
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/careerpilotdb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# Security JWT Config
JWT_SECRET=9a6f8b12c4e5780d314285960a7142bc890e1f3a567489b201cd34ef56789abc
JWT_EXPIRATION_MS=86400000

# AI Provider Integration (OpenAI / Gemini API Key)
AI_PROVIDER=MOCK # Set to OPENAI or GEMINI for live external AI
AI_API_KEY=your_openai_or_gemini_api_key_here

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=careerpilot-resumes

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_careerpilot_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# SMTP Email Notifications (Gmail SMTP or localhost SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=your_email@gmail.com

# Frontend Application URL for email verification links
APP_FRONTEND_URL=http://localhost:3000

